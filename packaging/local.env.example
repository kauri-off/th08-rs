# Personal settings for `cargo xtask dist --assets raw|packed`: copy to packaging/local/local.env (git-ignored).
# KEY=VALUE per line, ~/ expands; the same names as environment variables take precedence.
TH08_GAME_SRC=~/Games/Touhou Collection/TH08 - Imperishable Night/TH08 - Imperishable Night
TH08_KEYSTORE_PROPS=keystore/keystore.properties
# External replay sets (ref, ref500, ref_b2) for tools/arch_check and tools/batch_job; an absolute path (the scripts do not expand ~).
TH08_EXT_REPLAYS=/path/to/th08_ext_replays
