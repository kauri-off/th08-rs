// The port menu's settings page (docs/UI_RULES.md).
import { Tk, Ui } from "tokens.slint";
import { Label, Ringed, Arrow, FocusMark, Keycap, Heading, Target, BackLink, Tabs, SettingRow, RowData, Cap, Hint, HelpLine, HintLine, ScrollList } from "components.slint";

// Panel geometry from `portmenu::layout`, points.
export struct Geometry {
    panel-x: length, x: length, w: length, top: length, bottom: length, rail-w: length, rail-x: length, rail-text-w: length,
}

export struct SheetLine { text: string, x: length, cy: length, size: length, serif: bool, color: color }

// Ringed text lines at given places, for the text comparison sheet.
export component TextSheet inherits Window {
    in property <[SheetLine]> lines;
    background: transparent;
    for l in lines: Ringed {
        x: l.x;
        y: l.cy - l.size;
        height: l.size * 2;
        text: l.text;
        font-size: l.size;
        serif: l.serif;
        color: l.color;
        horizontal-alignment: left;
    }
}

// Measures one string for the layout check.
export component TextProbe inherits Window {
    in property <string> text;
    in property <length> size;
    in property <bool> serif;
    out property <length> natural: t.preferred-width;
    t := Text { text: root.text; font-size: root.size; font-family: root.serif ? Tk.serif : Tk.sans; }
}

export global PageApi {
    in-out property <Geometry> geo;
    in-out property <[string]> tabs;
    in-out property <[RowData]> rows;
    in-out property <[string]> label-pieces;
    in-out property <[Hint]> hints-first;
    in-out property <[Hint]> hints-rest;
    in-out property <string> heading;
    in-out property <string> caption;
    in-out property <string> back-word;
    in-out property <string> back-key;
    in-out property <string> prev-key;
    in-out property <string> next-key;
    in-out property <string> device;
    in-out property <string> ask;
    in-out property <int> tab;
    in-out property <int> cursor: 0;
    in-out property <bool> armed;
    in-out property <int> help-row: -1;
    in-out property <int> hovered: -1;
    callback step(int, int);
    callback pick(int, int);
    callback set-frac(int, float);
    callback activate(int);
    callback back();
    callback tab-changed(int);
    in-out property <length> scroll;
    in-out property <length> content-y;
    in-out property <length> scroll-max;
}

export component SettingsPage inherits Rectangle {
    property <Geometry> geo <=> PageApi.geo;
    property <[string]> tabs <=> PageApi.tabs;
    property <[RowData]> rows <=> PageApi.rows;
    property <[string]> label-pieces <=> PageApi.label-pieces;
    property <[Hint]> hints-first <=> PageApi.hints-first;
    property <[Hint]> hints-rest <=> PageApi.hints-rest;
    property <string> heading <=> PageApi.heading;
    property <string> caption <=> PageApi.caption;
    property <string> back-word <=> PageApi.back-word;
    property <string> back-key <=> PageApi.back-key;
    property <string> prev-key <=> PageApi.prev-key;
    property <string> next-key <=> PageApi.next-key;
    property <string> device <=> PageApi.device;
    property <string> ask <=> PageApi.ask;
    property <int> tab <=> PageApi.tab;
    property <int> cursor <=> PageApi.cursor;
    property <bool> armed <=> PageApi.armed;
    property <length> scroll-now: list.scroll;
    property <length> scroll-end: list.scroll-max;
    changed scroll-now => { PageApi.scroll = self.scroll-now; }
    changed scroll-end => { PageApi.scroll-max = self.scroll-end; }
    property <int> hovered-v <=> PageApi.hovered;

    property <length> row-h: Ui.split ? 120px : max(70px, Ui.tap);
    property <length> row-size: Ui.split ? Ui.font(28, 11) : Ui.font(25, 14);
    property <length> help-size: Ui.split ? Ui.font(24, 9.5) : Ui.font(19, 12);
    property <length> hint-size: Ui.font(16, 11);
    property <length> tab-size: Ui.split ? Ui.font(Ui.ru ? 28 : 30, 11) : Ui.font(Ui.ru ? 20 : 22, 13);
    // Phone: as narrow as the page's whole labels allow, so the sliders keep a long track.
    property <length> phone-label: clamp(whole.preferred-width + 16px, geo.w * 0.3, geo.w * 0.36);
    property <length> base-label: Ui.split ? phone-label : geo.w < 720px ? geo.w * 0.42 : min(440px, geo.w * 0.5);
    property <length> label-w: min(geo.w * 0.5, max(base-label, pieces.preferred-width + 24px));
    property <int> help-row <=> PageApi.help-row;
    property <string> help: help-row >= 0 && help-row < rows.length ? rows[help-row].help : "";

    Rectangle { background: Tk.wash; }
    Rectangle {
        visible: false;
        pieces := VerticalLayout {
            for p in label-pieces: Text { text: p; font-family: Tk.serif; font-size: root.row-size; }
        }
        whole := VerticalLayout {
            for r in root.rows: Text { text: r.kind == 3 ? "" : r.label; font-family: Tk.serif; font-size: root.row-size; }
        }
    }

    if Ui.split: Rectangle {
        x: 0;
        width: geo.rail-w;
        background: Tk.panel;
        Rectangle { x: parent.width - 1px; width: 1px; background: Tk.edge; }
        VerticalLayout {
            x: geo.rail-x;
            y: geo.top + 24px;
            width: geo.rail-text-w;
            height: geo.bottom - geo.top - 24px;
            spacing: 12px;
            BackLink { text: root.back-word; size: root.row-size * 1.14; rail: true; clicked => { PageApi.back(); } }
            Rectangle { height: 1px; background: Tk.rule; }
            Tabs {
                tabs: root.tabs; current: root.tab; rail: true; size: root.tab-size;
                bar: Ui.bar && root.cursor < 0; vertical-stretch: 1;
                pick(i) => { PageApi.tab-changed(i); }
            }
            Label { text: root.device; serif: false; font-size: Ui.font(19, 8); color: Tk.help; horizontal-alignment: left; wrap: word-wrap; vertical-stretch: 0; }
        }
    }

    panel := Rectangle {
        x: geo.panel-x;
        width: parent.width - self.x;
        background: Tk.panel;
        Rectangle { x: 0; width: 1px; background: Tk.edge; }
        Rectangle { x: 3px; width: 1px; background: Tk.edge-in; }
        VerticalLayout {
            x: 0;
            width: parent.width;
            y: geo.top;
            height: geo.bottom - geo.top;
            if !Ui.split: VerticalLayout {
                vertical-stretch: 0;
                padding-left: geo.x - geo.panel-x;
                padding-right: root.width - geo.x - geo.w;
                padding-top: 30px;
                spacing: 12px;
                HorizontalLayout {
                    Heading { alignment: start; word: root.heading; caption: root.caption; size: Ui.font(40, 18); caption-size: Ui.font(16, 11); horizontal-stretch: 0; }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: start;
                        horizontal-stretch: 0;
                        BackLink { text: root.back-word; key: root.back-key; size: Ui.font(17, 11); clicked => { PageApi.back(); } }
                    }
                }
                wide-tabs := Tabs {
                    tabs: root.tabs; current: root.tab; size: root.tab-size; prev-key: root.prev-key; next-key: root.next-key;
                    bar: Ui.bar && root.cursor < 0; height: self.tight ? 84px : 52px;
                    pick(i) => { PageApi.tab-changed(i); }
                }
                Rectangle { height: 1px; background: Tk.rule; }
            }
            if Ui.split: Rectangle { height: 24px; }
            list := ScrollList {
                content-y <=> PageApi.content-y;
                width: panel.width;
                vertical-stretch: 1;
                content-height: col.preferred-height;
                content-width: self.width;
                col := VerticalLayout {
                    width: list.width;
                    for r[i] in root.rows: SettingRow {
                        width: list.width;
                        data: r;
                        bar: Ui.bar && i == root.cursor;
                        inset: geo.x - geo.panel-x;
                        content-w: geo.w;
                        label-w: root.label-w;
                        row-h: root.row-h;
                        size: root.row-size;
                        armed: root.armed && r.kind == 3;
                        ask: root.ask;
                        shown: list.shown(self.y, self.height);
                        changed bar => { if (self.bar) { list.reveal(self.y, self.height); } }
                        changed hovering => {
                            if (self.hovering) { root.hovered-v = i; } else if (root.hovered-v == i) { root.hovered-v = -1; }
                        }
                        step(d) => { PageApi.step(i, d); }
                        pick(c) => { PageApi.pick(i, c); }
                        set(f) => { PageApi.set-frac(i, f); }
                        activate => { PageApi.activate(i); }
                    }
                }
            }
            VerticalLayout {
                padding-left: geo.x - geo.panel-x;
                padding-right: root.width - geo.x - geo.w;
                vertical-stretch: 0;
                padding-bottom: Ui.split ? 12px : 24px;
                spacing: 10px;
                Rectangle { height: 1px; background: Tk.rule; }
                HelpLine { text: root.help; font-size: root.help-size; min-height: root.help-size * 3; }
                if !Ui.split: HintLine { first: root.hints-first; rest: root.hints-rest; device: root.device; size: root.hint-size; }
            }
        }
        // More rows above / below: a mark in the right margin; the margin beside it pages the list.
        property <length> mark-x: geo.x + geo.w - geo.panel-x + (root.width - geo.x - geo.w) / 2 - 8px;
        if list.scroll > 0.5px: Target {
            x: geo.x + geo.w - geo.panel-x; y: 0; width: parent.width - self.x; height: parent.height / 2;
            name: "page-up";
            clicked => { list.page(-1); }
            Arrow { x: panel.mark-x - parent.x; y: list.y + 8px; dir: 2; tint: Tk.help; }
        }
        if list.scroll < list.scroll-max - 0.5px: Target {
            x: geo.x + geo.w - geo.panel-x; y: parent.height / 2; width: parent.width - self.x; height: parent.height / 2;
            name: "page-down";
            clicked => { list.page(1); }
            Arrow { x: panel.mark-x - parent.x; y: list.y + list.height - 22px - parent.y; dir: 3; tint: Tk.help; }
        }
    }
}
